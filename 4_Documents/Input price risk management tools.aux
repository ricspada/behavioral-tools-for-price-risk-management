\BKM@entry{id=23,dest={73656374696F6E2A2E3337},srcline={1503}}{5C3337365C3337375C303030435C3030306F5C3030306E5C303030635C3030306C5C303030755C303030735C303030695C3030306F5C3030306E5C30303073}
\BKM@entry{id=24,dest={73656374696F6E2A2E3338},srcline={1530}}{}
\@writefile{toc}{\contentsline {section}{Conclusions}{23}{section*.37}\protected@file@percent }
\newlabel{conclusions}{{}{23}{Conclusions}{section*.37}{}}
\@writefile{toc}{\contentsline {section}{We evaluate the adjusted contracts using Mean-Variance values under Expected Utility Theory and prospect values under Cumulative Prospect Theory. We also evaluate the outcomes under different decision framing: producers might frame the adoption of the contract in the context of a whole farm decision, considering it as a risk management tool (broad framing); alternatively, producers might narrowly frame the adoption as a standalone investment decision, considering it, in fact, as an investment. Results from the Montecarlo simulation, that incorporates both production and price risk, indicate that the contract delivers limited utility gains for farmers under broad framing, and that is not attractive when considered under narrow framing, suggesting that its real-word attractiveness may be low and that adoption could be limited if the contract were introduced.References}{24}{section*.38}\protected@file@percent }
\newlabel{we-evaluate-the-adjusted-contracts-using-mean-variance-values-under-expected-utility-theory-and-prospect-values-under-cumulative-prospect-theory.-we-also-evaluate-the-outcomes-under-different-decision-framing-producers-might-frame-the-adoption-of-the-contract-in-the-context-of-a-whole-farm-decision-considering-it-as-a-risk-management-tool-broad-framing-alternatively-producers-might-narrowly-frame-the-adoption-as-a-standalone-investment-decision-considering-it-in-fact-as-an-investment.-results-from-the-montecarlo-simulation-that-incorporates-both-production-and-price-risk-indicate-that-the-contract-delivers-limited-utility-gains-for-farmers-under-broad-framing-and-that-is-not-attractive-when-considered-under-narrow-framing-suggesting-that-its-real-word-attractiveness-may-be-low-and-that-adoption-could-be-limited-if-the-contract-were-introduced.references}{{}{24}{We evaluate the adjusted contracts using Mean-Variance values under Expected Utility Theory and prospect values under Cumulative Prospect Theory. We also evaluate the outcomes under different decision framing: producers might frame the adoption of the contract in the context of a whole farm decision, considering it as a risk management tool (broad framing); alternatively, producers might narrowly frame the adoption as a standalone investment decision, considering it, in fact, as an investment. Results from the Montecarlo simulation, that incorporates both production and price risk, indicate that the contract delivers limited utility gains for farmers under broad framing, and that is not attractive when considered under narrow framing, suggesting that its real-word attractiveness may be low and that adoption could be limited if the contract were introduced.References}{section*.38}{}}
